      }
    },
    "soccer": {
      "name": "Soccer",
      "defaultSalaryCap": 50000,
      "positions": {
        "classic": ["F", "F", "M", "M", "D", "D", "GK", "UTIL"],
        "showdown": ["CPT", "FLEX", "FLEX", "FLEX", "FLEX", "FLEX"]
      }
    },
    "nascar": {
