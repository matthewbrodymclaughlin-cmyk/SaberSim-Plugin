{
  "api": {
    "baseUrl": "https://api.sabersim.com",
    "apiKey": "YOUR_SABERSIM_API_KEY_HERE",
    "timeout": 60000,
    "endpoints": {
      "optimize": "/v1/optimize",
      "projections": "/v1/projections",
      "contests": "/v1/contests",
      "validate": "/v1/validate",
      "playerPool": "/v1/players",
      "ownership": "/v1/ownership"
    }
  },
  "defaults": {
    "sport": "nfl",
    "contestType": "classic",
    "site": "draftkings",
    "salaryCap": 50000,
    "numLineups": 1,
    "maxExposure": 100,
    "minExposure": 0,
    "minSalary": 49000,
    "randomness": false,
    "stacking": false,
    "stackSize": 3
  },
  "sports": {
