{
  "manifest_version": 3,
  "name": "SaberSim DFS Build Optimizer Pro",
  "version": "2.0.0",
  "description": "Professional DFS optimizer with SaberSim integration, Vegas data scraping, advanced stacking, and sim diversity",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://api.sabersim.com/*",
    "https://*.sabersim.com/*",
    "https://sportsbook.draftkings.com/*",
    "https://sportsbook.fanduel.com/*",
    "https://app.prizepicks.com/*",
    "https://underdogfantasy.com/*",
    "https://*.draftkings.com/*",
    "https://*.fanduel.com/*",
    "https://*.prizepicks.com/*",
    "https://*.underdogfantasy.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
